<Window x:Class="DesktopPetUi.MemoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记忆管理器"
        Width="700"
        Height="760"
        MinWidth="540"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <StackPanel x:Name="MainButtons" Orientation="Horizontal">
                <Button Content="清空记忆" Click="OnClearAll"
                        Background="#B55454" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,8,0"/>
                <Button x:Name="CompressButton" Content="一键压缩记忆" Click="OnCompress"
                        Background="#5A5A8A" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="保存修改" Click="OnSave"
                        Background="#3A7A4A" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="关闭" Click="OnClose"
                        Background="#888" Foreground="White" BorderThickness="0" Padding="12,6"/>
            </StackPanel>
            <Button x:Name="ArchiveClearButton" Content="清空归档记录" Click="OnClearArchive" Visibility="Collapsed"
                    Background="#B55454" Foreground="White" BorderThickness="0" Padding="12,6"/>
            <TextBlock x:Name="StatusText" Foreground="#2E8B57" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
            <TextBlock Text="手动添加对话（输入后点「添加」）" Foreground="#444" FontWeight="Bold"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="你" Foreground="#2A5C8A" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox x:Name="ManualUserBox" Grid.Column="2" MinHeight="30" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ManualAssistantLabel" Text="角色" Foreground="#7A4AA0" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox x:Name="ManualAssistantBox" Grid.Column="2" MinHeight="30" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                <Button Grid.Column="3" Content="添加" Click="OnAddManual"
                        Background="#3A7A4A" Foreground="White" BorderThickness="0"
                        Padding="12,6" Margin="6,0,0,0" VerticalAlignment="Top"/>
            </Grid>
        </StackPanel>

        <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" SelectionChanged="OnTabChanged">
            <TabItem x:Name="MainTab" Header="  当前记忆  ">
                <DockPanel Margin="2,8,2,0">
                    <TextBlock DockPanel.Dock="Top" Text="记忆摘要（会被注入到对话上下文）" Foreground="#444" Margin="0,0,0,4"/>
                    <TextBox x:Name="SummaryBox" DockPanel.Dock="Top" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                              VerticalScrollBarVisibility="Auto"
                              Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 对话历史（可编辑） -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Foreground="#444" Margin="0,0,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="HistoryList" Background="#FFFFFF" BorderBrush="#C8C8C8" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayRole}" Foreground="#2A5C8A" FontWeight="Bold"
                                               VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="#888" FontSize="11"
                                               VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="30"
                                             Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                                    <Button Grid.Column="3" Content="删除" Click="OnDeleteEntry" Tag="{Binding}"
                                            Background="#B55454" Foreground="White" BorderThickness="0"
                                            Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>

            <!-- Agent 操作记录（只读审计轨迹，持久化于 agent_ops.json） -->
            <Border Grid.Row="1" Background="#F5F6F8" BorderBrush="#DCDEE4" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Agent 操作记录" Foreground="#333" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="OpsCountText" Foreground="#999" FontSize="11.5" Margin="8,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="清空操作记录" Click="OnClearOps"
                                Background="#8A5A5A" Foreground="White" BorderThickness="0" Padding="10,3" FontSize="12"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <ListBox x:Name="OpsList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E4E6EC" BorderThickness="1" CornerRadius="5" Margin="0,3" Padding="9,7">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="9" Padding="8,1.5,8,1.5" VerticalAlignment="Center">
                                                    <Border.Background><SolidColorBrush Color="{Binding BadgeColor}"/></Border.Background>
                                                    <TextBlock Text="{Binding VerdictText}" Foreground="White" FontSize="11"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding ToolLabel}" Foreground="#333" FontWeight="SemiBold"
                                                           FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#999" FontSize="11"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                            <Border Background="#F4F5F7" CornerRadius="3" Padding="6,4" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Detail}" Foreground="#444" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="{Binding NoteLine}" Foreground="#8A6D3B" FontSize="11" Margin="0,4,0,0"
                                                       Visibility="{Binding NoteVisible}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="ArchiveTab" Header="  归档记录（只读）  ">
                <DockPanel Margin="2,8,2,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="ArchiveCountText" Foreground="#444"/>
                        <TextBlock Text="  ·  记忆压缩时被摘要替代的原始记录，持久化于 memory_archive.json" Foreground="#999" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ArchiveList" Background="#FFFFFF" BorderBrush="#C8C8C8" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayRole}" Foreground="#2A5C8A" FontWeight="Bold"
                                                   VerticalAlignment="Top" Margin="0,3,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="#888" FontSize="11"
                                                   VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Content}" Foreground="#333" TextWrapping="Wrap"
                                                   Background="#FAFAFB" Padding="6,4"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>