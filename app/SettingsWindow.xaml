<Window x:Class="DesktopPetUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="700"
        Height="520"
        MinWidth="580"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="14,0,14,10"
                   FontSize="12" Foreground="#2E8B57" Text=""/>
    <TabControl Margin="10" Background="#FFFFFF">
        <TabItem Header="角色设置" Background="#FFFFFF">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="角色" Foreground="#444" Margin="0,0,0,6"/>
                    <ListBox x:Name="CharacterList" Grid.Row="1" SelectionChanged="OnCharacterSelected"
                             Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="SetCurrentButton" Content="设为当前角色" Click="OnSetCurrent"
                                Background="#3A5A8A" Foreground="White" BorderThickness="0" Padding="8,6" IsEnabled="False"/>
                        <TextBlock x:Name="CurrentLabel" Foreground="#668" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="3" Margin="0,10,0,0" Background="#FFFFFF" BorderBrush="#C8C8C8"
                            BorderThickness="1" CornerRadius="6" Padding="6" Height="220">
                        <Grid>
                            <Image x:Name="CharPreviewImage" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CharPreviewEmptyText" Text="暂无立绘预览"
                                       Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="名称" Foreground="#444" Margin="0,0,0,4"/>
                    <TextBlock x:Name="NameText" Grid.Row="1" Foreground="#111" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Text="System Prompt（角色人设 / LLM 提示词）" Foreground="#444" Margin="0,0,0,4"/>
                    <TextBox x:Name="PromptBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8" Margin="0,0,0,10"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Temperature（默认 0.7，可自行调整）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="TemperatureBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MaxTokens（留空则使用全局默认）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="MaxTokensBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TTS 语言（auto=自动检测）" Foreground="#444" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CharTextLangBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8">
                                <ComboBoxItem Content="auto（自动检测）" Tag="auto"/>
                                <ComboBoxItem Content="ja（日语）" Tag="ja"/>
                                <ComboBoxItem Content="zh（中文）" Tag="zh"/>
                                <ComboBoxItem Content="en（英语）" Tag="en"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TTS 音色（本地服务可下拉选择，留空使用默认）" Foreground="#444" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CharVoiceBox" IsEditable="True" StaysOpenOnEdit="True"
                                      Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TTS 服务商（默认不调用语音）" Foreground="#444" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CharTtsProviderBox" SelectionChanged="OnCharTtsProviderChanged"
                                      Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8">
                                <ComboBoxItem Content="不调用 TTS" Tag="none"/>
                                <ComboBoxItem Content="本地 GPT-SoVITS" Tag="gptsovits"/>
                                <ComboBoxItem Content="Windows 语音（SAPI）" Tag="windows"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="主动搭话 Temperature（默认 0.7，可自行调整）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="CharProactiveTempBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="7" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="对用户的称呼（留空使用全局默认）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="CharUserAddressBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <CheckBox x:Name="CharScaleInheritCheck" Content="立绘缩放：继承全局" Foreground="#222" Margin="0,0,0,4"
                                      Checked="OnCharScaleInheritChanged" Unchecked="OnCharScaleInheritChanged"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="CharScaleSlider" Minimum="0.2" Maximum="3.0"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"
                                        ValueChanged="OnCharScaleValueChanged"/>
                                <TextBlock x:Name="CharScaleValueText" Foreground="#444" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="34"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="8" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TTS 语速（speed_factor，0.5–2.0）" Foreground="#444" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="CharSpeedSlider" Minimum="0.5" Maximum="2.0"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"
                                        ValueChanged="OnCharSpeedValueChanged"/>
                                <TextBlock x:Name="CharSpeedValueText" Foreground="#444" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="34"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="0.8–1.2 较自然，默认 1.0" Foreground="#999" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="9" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SaveButton" Content="保存" Click="OnSave" IsEnabled="False"
                                    Background="#3A7A4A" Foreground="White" BorderThickness="0" Padding="16,7" Margin="0,0,8,0"/>
                            <Button Content="关闭" Click="OnClose" Background="#888" Foreground="White" BorderThickness="0" Padding="16,7"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="全局设置" Background="#FFFFFF">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                <Grid Margin="12,12,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="LLM 服务（OpenAI 兼容接口，全局默认）"
                               Foreground="#2A5C8A" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="接口格式" Foreground="#444" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProviderBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" SelectionChanged="OnProviderChanged"
                              Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8">
                        <ComboBoxItem Content="OpenAI 兼容" Tag="openai"/>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API 地址（可从预设选择或手动输入）" Foreground="#444" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ApiBaseUrlBox" Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" IsEditable="True"
                              StaysOpenOnEdit="True"
                              Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8">
                        <ComboBoxItem Content="https://api.deepseek.com"/>
                        <ComboBoxItem Content="https://api.openai.com"/>
                        <ComboBoxItem Content="https://api.siliconflow.cn/v1"/>
                        <ComboBoxItem Content="https://api.moonshot.cn/v1"/>
                        <ComboBoxItem Content="http://127.0.0.1:8080"/>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="API Key（掩码显示，留空则不附加）" Foreground="#444" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ApiKeyBox" Grid.Row="3" Grid.Column="2" Margin="0,0,0,8"
                                 Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="模型名称（可点击右侧按钮获取）" Foreground="#444" Margin="0,0,0,4"/>
                    <Grid Grid.Row="4" Grid.Column="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ApiModelBox" Grid.Column="0" IsEditable="True" StaysOpenOnEdit="True"
                                  Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        <Button x:Name="FetchApiModelsButton" Grid.Column="2" Content="获取模型" Click="OnFetchApiModels"
                                Background="#5A5A8A" Foreground="White" BorderThickness="0" Padding="10,4"/>
                    </Grid>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="高级参数（JSON，将附加到请求体）" Foreground="#444" Margin="0,0,0,4"/>
                    <TextBox x:Name="ExtraParamsBox" Grid.Row="5" Grid.Column="2" Margin="0,0,0,8"
                             FontFamily="Consolas" FontSize="12"
                             Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="网络代理（仅 LLM 请求）" Foreground="#444" Margin="0,0,0,4"/>
                    <Grid Grid.Row="6" Grid.Column="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProxyModeBox" Grid.Column="0" SelectionChanged="OnProxyModeChanged"
                                  Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8">
                            <ComboBoxItem Content="使用系统代理" Tag="system"/>
                            <ComboBoxItem Content="不使用代理" Tag="none"/>
                            <ComboBoxItem Content="自定义代理" Tag="custom"/>
                        </ComboBox>
                        <TextBox x:Name="ProxyAddressBox" Grid.Column="2" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"
                                 ToolTip="例如 http://127.0.0.1:7890"/>
                    </Grid>

                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Text="TTS 服务" Foreground="#2A5C8A" FontWeight="Bold" Margin="0,8,0,8"/>
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="GPT-SoVITS 服务器地址（本地语音合成）" Foreground="#444" Margin="0,0,0,4"/>
                    <TextBox x:Name="TtsUrlBox" Grid.Row="8" Grid.Column="2" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8" Margin="0,0,0,8"/>
                    <CheckBox x:Name="TtsStreamingCheck" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                              Content="流式合成（逐句合成、边收边播，降低首句延迟；仅 GPT-SoVITS 生效）"
                              Foreground="#222" Margin="0,0,8,8" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Text="对话 / 角色" Foreground="#2A5C8A" FontWeight="Bold" Margin="0,8,0,8"/>
                    <Grid Grid.Row="11" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="默认称呼（全局，角色未设置时使用）" Foreground="#444" VerticalAlignment="Center"/>
                        <TextBox x:Name="GlobalUserAddressBox" Grid.Column="2" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                    </Grid>
                    <Grid Grid.Row="12" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="对话上下文长度（条）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="ContextLengthBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="主动搭话间隔（秒）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProactiveIntervalBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="立绘空闲换图间隔（秒）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="IdleIntervalBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="气泡预留高度（像素）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="BubbleReserveBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="13" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ProactiveCheck" Grid.Column="0" Content="角色主动向用户搭话" Foreground="#222" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ScreenAwareCheck" Grid.Column="2" Content="屏幕感知（多模态，需 vision 模型）" Foreground="#222" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="观察概率" Foreground="#444" VerticalAlignment="Center"/>
                        <TextBox x:Name="ScreenAwareChanceBox" Grid.Column="5" Width="80" HorizontalAlignment="Left" Margin="8,0,0,0"
                                 Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        <CheckBox x:Name="CrossFadeCheck" Grid.Column="7" Content="立绘切换过渡效果（淡入淡出）" Foreground="#222" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="14" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="气泡显示时长（秒）" Foreground="#444" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="BubbleDurationSlider" Minimum="2" Maximum="20" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Width="200" VerticalAlignment="Center"
                                    ValueChanged="OnBubbleDurationValueChanged"/>
                            <TextBlock x:Name="BubbleDurationValueText" Foreground="#444" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="16" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="对话上下文字数阈值（字）" Foreground="#444" Margin="0,0,0,4"/>
                            <TextBox x:Name="ContextMaxCharsBox" Background="#FFFFFF" Foreground="#222" BorderBrush="#C8C8C8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="0 表示不启用字数压缩" Foreground="#999" Margin="0,0,0,4"/>
                            <TextBlock Text="超过条数上限或字数阈值即压缩" Foreground="#999"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="15" Grid.ColumnSpan="3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="保存全局设置" Click="OnSaveGlobal"
                                    Background="#3A7A4A" Foreground="White" BorderThickness="0" Padding="16,7" Margin="0,0,8,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </DockPanel>
</Window>