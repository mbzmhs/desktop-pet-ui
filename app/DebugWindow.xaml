<Window x:Class="DesktopPetUi.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="调试窗口"
        Width="680"
        Height="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6" Background="#E6E6E6">
            <Button Content="清空" Click="OnClear" Background="#888" Foreground="White" BorderThickness="0" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="复制全部" Click="OnCopy" Background="#888" Foreground="White" BorderThickness="0" Padding="12,4"/>
        </StackPanel>
        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Background="#FFFFFF" Foreground="#222"
                 BorderThickness="0" Padding="6"/>
    </DockPanel>
</Window>