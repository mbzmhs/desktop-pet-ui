<Window x:Class="DesktopPetUi.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo 列表"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="380" SizeToContent="Height">
    <Border Background="#E61B1F2A" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid Margin="14,10,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 头部：标题 + 进度 + 右上角隐藏按钮（可拖拽移动窗口） -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Todo 列表" FontSize="14" FontWeight="SemiBold" Foreground="#F0F2F5"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressText" Grid.Column="1" FontSize="12" Foreground="#8A93A6"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="HideBtn" Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Click="OnHideClick" ToolTip="隐藏窗口"
                        Background="Transparent" Foreground="#9AA3B5" BorderThickness="0" Padding="6,4" Cursor="Hand"/>
            </Grid>
            <!-- 只读列表 -->
            <Border Grid.Row="1" Margin="0,10,0,0">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Padding="2,0">
                    <StackPanel x:Name="ItemPanel"/>
                </ScrollViewer>
            </Border>
            <!-- 全部完成后出现的确定按钮（点击=清空并隐藏） -->
            <Button x:Name="ConfirmBtn" Grid.Row="2" Content="确 定" Click="OnConfirmClick"
                    Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                    Background="#3A7A4A" Foreground="White" BorderThickness="0" Padding="0,7" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
