<Window x:Class="DesktopPetUi.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat"
        WindowStyle="None"
        Background="#FF202226"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Topmost="True"
        MinWidth="400" 
        MinHeight="300"
        ShowActivated="True">
    <!-- WindowChrome：保留自定义标题栏，同时获得正常 Windows 窗体的行为（拖拽移动、双击最大化/还原、边缘缩放、Aero Snap） -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="Shell"
            Background="#FF202226"
            Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 标题栏（WindowChrome 原生拖动/双击最大化；按钮需标记 IsHitTestVisibleInChrome） -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonUp="OnTitleBarMouseUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#E0A0F0" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TitleText" Text="聊天" FontSize="14" FontWeight="SemiBold"
                               Foreground="#DDD" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 上下文占用（API usage.prompt_tokens / 设置里的 token 预算） -->
                <TextBlock x:Name="UsageText" Grid.Column="1" FontSize="10.5" Foreground="#7A8"
                           VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="TodoBtn" Content="&#xE73B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="OnTodoClick" ToolTip="Todo 列表" WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" Foreground="#AAA" BorderThickness="0" Padding="9,5"/>
                    <Button x:Name="JobBtn" Content="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="OnJobClick" ToolTip="后台任务" WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" Foreground="#AAA" BorderThickness="0" Padding="9,5"/>
                    <Button x:Name="MinBtn" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="OnMinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" Foreground="#AAA" BorderThickness="0" Padding="9,5"/>
                    <Button x:Name="MaxBtn" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="OnMaxRestoreClick" WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" Foreground="#AAA" BorderThickness="0" Padding="9,5"/>
                    <Button x:Name="CloseBtn" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" Foreground="#AAA" BorderThickness="0" Padding="9,5"/>
                </StackPanel>
            </Grid>
            <!-- 消息流 -->
            <ScrollViewer x:Name="MsgScroll" Grid.Row="1" Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MsgPanel"/>
            </ScrollViewer>
            <!-- 状态 + 输入行 -->
            <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#888" FontSize="11.5"
                       Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="14"/>
            <Grid x:Name="InputRow" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox"
                         Background="#2A2D33"
                         Foreground="#EEE"
                         CaretBrush="#EEE"
                         BorderBrush="#444"
                         BorderThickness="1"
                         FontSize="14"
                         Padding="6,5"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="38"
                         MaxHeight="96"
                         VerticalScrollBarVisibility="Auto"
                         KeyDown="OnInputKeyDown"/>
                <Button x:Name="StopBtn" Grid.Column="1" Content="停止" Click="OnStopClick"
                        Background="#B94A4A" Foreground="White" BorderThickness="0"
                        FontSize="14" Padding="12,5" Margin="8,0,0,0" Cursor="Hand"
                        Visibility="Collapsed"/>
                <Button x:Name="SendBtn" Grid.Column="2" Content="发送" Click="OnSendClick"
                        Background="#3D7EBF" Foreground="White" BorderThickness="0"
                        FontSize="14" Padding="14,5" Margin="8,0,0,0" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
