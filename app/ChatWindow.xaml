<Window x:Class="DesktopPetUi.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="True">
    <Border x:Name="Shell"
            Background="#EE1E1E1E"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#555"
            Padding="12">
        <DockPanel>
            <TextBlock x:Name="HintText" Text="和宠物说点什么…" Foreground="#888" FontSize="12"
                       DockPanel.Dock="Top" Margin="0,0,0,6"/>
            <TextBox x:Name="InputBox" DockPanel.Dock="Top"
                     Background="#222"
                     Foreground="#EEE"
                     BorderBrush="#444"
                     BorderThickness="1"
                     FontSize="15"
                     Padding="6,5"
                     VerticalContentAlignment="Center"
                     MaxLength="500"/>
            <TextBlock x:Name="StatusText" Foreground="#AAA" FontSize="12"
                       DockPanel.Dock="Bottom"
                       Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="16"/>
            <ScrollViewer x:Name="HistoryScroll" Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Header}" FontSize="11" Foreground="{Binding HeaderColor}"/>
                                <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#EEE"
                                           TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>