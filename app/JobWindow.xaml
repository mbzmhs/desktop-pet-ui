<Window x:Class="DesktopPetUi.JobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="后台任务"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="460" SizeToContent="Height">
    <Border Background="#E61B1F2A" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid Margin="14,10,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 头部：标题 + 统计 + 右上角隐藏按钮（可拖拽移动窗口） -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="后台任务" FontSize="14" FontWeight="SemiBold" Foreground="#F0F2F5"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatsText" Grid.Column="1" FontSize="12" Foreground="#8A93A6"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="HideBtn" Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Click="OnHideClick" ToolTip="隐藏窗口"
                        Background="Transparent" Foreground="#9AA3B5" BorderThickness="0" Padding="6,4" Cursor="Hand"/>
            </Grid>
            <!-- 任务列表（每秒自动刷新） -->
            <Border Grid.Row="1" Margin="0,10,0,0">
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Padding="2,0">
                    <StackPanel x:Name="JobPanel"/>
                </ScrollViewer>
            </Border>
            <!-- 底部：清除已完成 -->
            <Button x:Name="ClearBtn" Grid.Row="2" Content="清除已完成" Click="OnClearClick"
                    Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                    Background="#4A5568" Foreground="White" BorderThickness="0" Padding="0,6" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
